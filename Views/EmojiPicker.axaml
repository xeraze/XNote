<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XNote.Views"
             x:Class="XNote.Views.EmojiPicker"
             x:CompileBindings="False"
             Width="320" Height="360">
  <UserControl.Resources>
    <StreamGeometry x:Key="IconCloseMini">M 10.586,2.086 L 8,4.672 L 5.414,2.086 L 4,3.5 L 6.586,6.086 L 4,8.672 L 5.414,10.086 L 8,7.5 L 10.586,10.086 L 12,8.672 L 9.414,6.086 L 12,3.5 Z</StreamGeometry>
  </UserControl.Resources>
  <Grid Background="{DynamicResource XnPanelBrush}"
        RowDefinitions="Auto,Auto,Auto,*">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="10,10,10,6">
        <Button x:Name="TabBasicButton" Classes="flat emojiTab" Padding="10,5" FontSize="12" Click="TabBasic_Click"
                Content="{Binding EmojiTabNative}" />
        <Button x:Name="TabSymbolsButton" Classes="flat emojiTab" Padding="10,5" FontSize="12" Click="TabSymbols_Click"
                Content="{Binding EmojiTabSymbols}" />
        <Button x:Name="TabCustomButton" Classes="flat emojiTab" Padding="10,5" FontSize="12" Click="TabCustom_Click"
                Content="{Binding EmojiTabCustom}" />
      </StackPanel>

      <TextBox x:Name="SearchBox" Grid.Row="1" Margin="10,0,10,8" Height="30" FontSize="12"
               PlaceholderText="{Binding EmojiSearchPlaceholder}"
               TextChanged="SearchBox_TextChanged" />

      <StackPanel x:Name="CustomActionsBar" Grid.Row="2" Spacing="4" Margin="10,0,10,8" IsVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="flat" Padding="8,4" FontSize="11" Click="DrawCustom_Click" Content="{Binding DrawCustomButton}" />
          <Button x:Name="UploadCustomBtn" Classes="flat" Padding="8,4" FontSize="11" Click="UploadCustom_Click" Content="{Binding DrawFileButton}" IsVisible="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="CustomEmojiBtn" Classes="filtertab active" Padding="10,3" FontSize="11" Content="{Binding CustomEmojiCategory}" Click="CustomEmojiBtn_Click" />
          <Button x:Name="CustomSymbolsBtn" Classes="filtertab" Padding="10,3" FontSize="11" Content="{Binding CustomSymbolsCategory}" Click="CustomSymbolsBtn_Click" />
        </StackPanel>
        <TextBlock x:Name="CustomHintText" Text="{Binding CustomFormatsHint}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource XnTextFaintBrush}" />
        <TextBlock x:Name="CustomErrorText" Text="" FontSize="10" TextWrapping="Wrap" Foreground="#B33030" IsVisible="False" />
      </StackPanel>

      <ScrollViewer Grid.Row="3" Padding="6,0,6,10">
        <ItemsControl x:Name="EmojiGrid">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="emojiCell"
                      Tag="{Binding}"
                      ToolTip.Tip="{Binding Name}"
                      Click="EmojiCell_Click" Width="36" Height="36" Padding="2">
                <Panel>
                  <TextBlock Text="{Binding Char}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !IsImage}" FontSize="18" />
                  <Image Source="{Binding Image}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding IsImage}" />
                  <Button Classes="emojiDeleteBtn" Tag="{Binding}" Click="DeleteCustomEmoji_Click"
                          IsVisible="{Binding IsImage}"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Width="16" Height="16" Padding="0" Margin="2"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Classes="rivet" Data="{StaticResource IconCloseMini}" Width="9" Height="9"
                              Foreground="White" />
                  </Button>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock x:Name="CustomEmptyLabel" Grid.Row="3" IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource XnTextFaintBrush}" FontSize="12" />
  </Grid>
</UserControl>