<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XNote.ViewModels"
        xmlns:views="using:XNote.Views"
        x:Class="XNote.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://XNote/Assets/xnote.ico"
        Title="XNote"
        Width="980" Height="640"
        MinWidth="720" MinHeight="480"
        Background="{StaticResource XnBlackBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32">

  <Window.Resources>
    <SolidColorBrush x:Key="DotOpen" Color="{StaticResource XnTextFaintColor}" />

    <StreamGeometry x:Key="IconPlus">M 12,5 L 12,19 M 5,12 L 19,12</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M 5,7 L 19,7 M 9,7 L 9,5 L 15,5 L 15,7 M 7,7 L 7,20 L 17,20 L 17,7 M 10,11 L 10,16 M 14,11 L 14,16</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M 6,6 L 18,18 M 18,6 L 6,18</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M 5,13 L 10,18 L 19,7</StreamGeometry>

    <StreamGeometry x:Key="IconDot">M 10,6 L 14,10 L 10,14 L 6,10 Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>

    <Style Selector="ToggleButton.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>
    <Style Selector="ToggleButton.flat:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource XnTextDimBrush}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#5A3030" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#E08080" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A1616" />
    </Style>

    <Style Selector="Button.iconbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource XnTextDimBrush}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>

    <Style Selector="Button.iconbtn.deletebtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A1616" />
    </Style>
    <Style Selector="Button.iconbtn.deletebtn:pointerover Path">
      <Setter Property="Stroke" Value="#E08080" />
    </Style>

    <Style Selector="PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    
    <Style Selector="Path.line-icon">
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <Style Selector="Button.filtertab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource XnTextDimBrush}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.filtertab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>
    <Style Selector="Button.filtertab.active">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource XnTextDimBrush}" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
    </Style>

    <Style Selector="Button.formatbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.formatbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource XnPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource XnAccentBrush}" />
      <Setter Property="SelectionBrush" Value="#33FFFFFF" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource XnTextFaintBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource XnTextDimBrush}" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#141414" />
    </Style>

    <Style Selector="Button.titlebtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.titlebtn Path">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Button.titlebtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>
    <Style Selector="Button.titlebtn-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#5A2020" />
    </Style>
    <Style Selector="Button.titlebtn-close:pointerover Path">
      <Setter Property="Stroke" Value="#F0A0A0" />
    </Style>
  </Window.Styles>

  <Panel>
    <Grid ColumnDefinitions="300,1,*">

    <Grid Grid.Column="0" RowDefinitions="32,Auto,Auto,Auto,*,Auto" Background="{StaticResource XnBlackBrush}">

      <Border Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed" />

      <TextBlock Grid.Row="1" Text="XNOTE"
                 Foreground="{StaticResource XnAccentBrush}"
                 FontSize="15" FontWeight="Medium" LetterSpacing="4"
                 Margin="20,10,20,16" />

      <Grid Grid.Row="2" Margin="16,0,16,12" ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0">
          <TextBox Watermark="Search notes…"
                   Text="{Binding SearchText}"
                   Height="34"
                   Padding="34,0,10,0"
                   VerticalContentAlignment="Center"
                   FontSize="13" />
          <Canvas Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
            <Ellipse Width="9" Height="9" Canvas.Left="0" Canvas.Top="0"
                     Stroke="{StaticResource XnTextFaintBrush}" StrokeThickness="1.5" />
            <Line StartPoint="8,8" EndPoint="13,13"
                  Stroke="{StaticResource XnTextFaintBrush}" StrokeThickness="1.5" />
          </Canvas>
        </Grid>
        <Button Grid.Column="1" Classes="iconbtn" Margin="6,0,0,0"
                Command="{Binding AddNoteCommand}"
                ToolTip.Tip="New note (Ctrl+N)">
          <Path Classes="line-icon" Data="{StaticResource IconPlus}" Stroke="{StaticResource XnTextBrush}" Width="16" Height="16" Stretch="Uniform" />
        </Button>
      </Grid>

      <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,20,10">
        <Button Classes="filtertab" Margin="0,0,6,6" Classes.active="{Binding IsFilterAll}" Content="All" Command="{Binding SetFilterAllCommand}" />
        <Button Classes="filtertab" Margin="0,0,6,6" Classes.active="{Binding IsFilterNotes}" Content="Notes" Command="{Binding SetFilterNotesCommand}" />
        <Button Classes="filtertab" Margin="0,0,6,6" Classes.active="{Binding IsFilterTasks}" Content="Tasks" Command="{Binding SetFilterTasksCommand}" />
        <Button Classes="filtertab" Margin="0,0,6,6" Classes.active="{Binding IsFilterOpen}" Content="Open" Command="{Binding SetFilterOpenCommand}" />
        <Button Classes="filtertab" Margin="0,0,6,6" Classes.active="{Binding IsFilterDone}" Content="Done" Command="{Binding SetFilterDoneCommand}" />
      </WrapPanel>

      <ListBox Grid.Row="4"
               ItemsSource="{Binding FilteredNotes}"
               SelectedItem="{Binding SelectedNote}"
               Background="Transparent"
               Padding="12,0,4,0"
               Margin="0,0,4,0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NoteViewModel">
              <Grid ColumnDefinitions="Auto,*" Margin="10,8">
                <Grid Grid.Column="0" Width="14" Height="14" Margin="0,3,10,0" VerticalAlignment="Top">
                  <PathIcon Data="{StaticResource IconDot}" Width="10" Height="10"
                            Foreground="{StaticResource XnTextDimBrush}"
                            IsVisible="{Binding !IsTask}" />

                  <Border IsVisible="{Binding IsTask}"
                          Width="14" Height="14" CornerRadius="3"
                          BorderThickness="1.4"
                          BorderBrush="{Binding IsDone, Converter={x:Static vm:Converters.DoneToBrush}}"
                          Background="{Binding IsDone, Converter={x:Static vm:Converters.DoneToBrush}}">
                    <Path Classes="line-icon" Data="{StaticResource IconCheck}"
                          Width="9" Height="9" Stretch="Uniform"
                          Stroke="{StaticResource XnBlackBrush}"
                          IsVisible="{Binding IsDone}" />
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Title}"
                             Foreground="{StaticResource XnTextBrush}"
                             FontSize="14" FontWeight="Medium"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Preview}"
                             Foreground="{StaticResource XnTextDimBrush}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="20,10,20,16" Spacing="16">
        <TextBlock Text="{Binding TotalCountLabel}"
                   Foreground="{StaticResource XnTextFaintBrush}" FontSize="11" />
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Background="{StaticResource XnBorderSubtleBrush}" />

    <Grid Grid.Column="2" Background="{StaticResource XnBlackBrush}" IsVisible="{Binding HasSelection}">
      <Grid DataContext="{Binding SelectedNote}" x:DataType="vm:NoteViewModel"
            RowDefinitions="32,Auto,Auto,Auto,*,Auto">
        <Border Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed" />
        
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="32,10,32,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0"
                      VerticalAlignment="Center" IsVisible="{Binding IsDraft}">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource XnTextFaintBrush}" />
            <TextBlock Text="Draft" FontSize="11"
                       Foreground="{StaticResource XnTextFaintBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <TextBox Grid.Column="1"
                    Text="{Binding Title, Mode=TwoWay}"
                    FontSize="20" FontWeight="Medium"
                    BorderThickness="0" Background="Transparent"
                    Padding="0" Watermark="Untitled" />

          <Button Grid.Column="2" Classes="flat" Margin="6,0,0,0"
                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveNoteCommand}"
                  IsVisible="{Binding IsDraft}"
                  ToolTip.Tip="Save this note"
                  Content="Save" />

          <ToggleButton Grid.Column="3" Classes="flat" Margin="6,0,0,0"
                        IsChecked="{Binding IsTask, Mode=TwoWay}"
                        ToolTip.Tip="Mark as a task with a done/not-done state"
                        Content="Task" />
          <ToggleButton Grid.Column="4" Classes="flat" Margin="6,0,0,0"
                        IsChecked="{Binding IsDone, Mode=TwoWay}"
                        IsVisible="{Binding IsTask}"
                        ToolTip.Tip="Mark this task as done"
                        Content="Done" />

          <Grid Grid.Column="5" Margin="10,0,0,0">
            <Button Classes="iconbtn deletebtn"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestDeleteCommand}"
                    IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsConfirmingDelete}"
                    ToolTip.Tip="Delete this note">
              <Path Classes="line-icon" Data="{StaticResource IconTrash}" Stroke="{StaticResource XnTextDimBrush}" Width="16" Height="16" Stretch="Uniform" />
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsConfirmingDelete}">
              <TextBlock Text="Delete this note?"
                         Foreground="{StaticResource XnTextDimBrush}"
                         FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
              <Button Classes="danger" Padding="10,6"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConfirmDeleteCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="line-icon" Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform" Stroke="#E08080" />
                  <TextBlock Text="Delete" FontSize="12" />
                </StackPanel>
              </Button>
              <Button Classes="flat" Padding="10,6"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDeleteCommand}"
                      Content="Cancel" FontSize="12" />
            </StackPanel>
          </Grid>
        </Grid>

        <TextBox Grid.Row="2" Margin="32,10,32,0"
                 Text="{Binding TagsText, Mode=TwoWay}"
                 Watermark="Add tags, separated by commas…"
                 FontSize="12" Height="30" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="32,14,32,0">
          <Button Classes="formatbtn" Focusable="False" Click="Bold_Click" ToolTip.Tip="Bold selection">
            <TextBlock Text="B" FontWeight="Bold" FontSize="13" />
          </Button>
          <Button Classes="formatbtn" Focusable="False" Click="Italic_Click" ToolTip.Tip="Italicize selection">
            <TextBlock Text="I" FontStyle="Italic" FontSize="13" />
          </Button>
          <Border Width="1" Background="{StaticResource XnBorderSubtleBrush}" Margin="4,4" />
          <Button Classes="formatbtn" Focusable="False" Click="Heading1_Click" ToolTip.Tip="Heading">
            <TextBlock Text="H1" FontSize="12" />
          </Button>
          <Button Classes="formatbtn" Focusable="False" Click="Heading2_Click" ToolTip.Tip="Subheading">
            <TextBlock Text="H2" FontSize="12" />
          </Button>
        </StackPanel>

        <views:RichTextEditor Name="BodyEditor" Grid.Row="4" Margin="32,10,32,0"
                              VerticalAlignment="Top" />

        <TextBlock Name="BodyWatermark" Grid.Row="4" Margin="32,10,32,0"
                   Text="Write something…" FontSize="14"
                   Foreground="{StaticResource XnTextDimBrush}"
                   IsHitTestVisible="False" IsVisible="False" />

        <TextBlock Grid.Row="5" Margin="32,8,32,24" Text="{Binding MetaLabel}"
                   Foreground="{StaticResource XnTextFaintBrush}" FontSize="11" />
      </Grid>
    </Grid>

    <Grid Grid.Column="2" Background="{StaticResource XnBlackBrush}" IsVisible="{Binding !HasSelection}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <Path Classes="line-icon" Data="{StaticResource IconPlus}" Width="28" Height="28" Stretch="Uniform"
                   Stroke="{StaticResource XnTextFaintBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="No note selected" Foreground="{StaticResource XnTextDimBrush}"
                   FontSize="14" HorizontalAlignment="Center" />
        <TextBlock Text="Pick a note on the left, or create a new one" Foreground="{StaticResource XnTextFaintBrush}"
                   FontSize="12" HorizontalAlignment="Center" />
        <Button Classes="flat" HorizontalAlignment="Center"
                Command="{Binding AddNoteCommand}" Content="Create your first note" />
      </StackPanel>
    </Grid>

    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="2"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,5,10,0">
      <Button Classes="titlebtn" Click="Minimize_Click" ToolTip.Tip="Minimize">
        <Path Data="M 3,7.5 L 13,7.5 L 13,8.5 L 3,8.5 Z" Stretch="Uniform" Fill="{StaticResource XnTextDimBrush}" />
      </Button>
      <Button Classes="titlebtn" Click="MaximizeRestore_Click" ToolTip.Tip="Maximize">
        <Path Data="M 3,3 L 13,3 L 13,13 L 3,13 Z" Stretch="Uniform" Stroke="{StaticResource XnTextDimBrush}" StrokeThickness="1.3" />
      </Button>
      <Button Classes="titlebtn titlebtn-close" Click="Close_Click" ToolTip.Tip="Close">
        <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stretch="Uniform" Stroke="{StaticResource XnTextDimBrush}" StrokeThickness="1.3" StrokeLineCap="Round" />
      </Button>
    </StackPanel>
  </Panel>
</Window>