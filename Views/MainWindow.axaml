<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XNote.ViewModels"
        x:Class="XNote.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://XNote/Assets/xnote.ico"
        Title="XNote"
        Width="980" Height="640"
        MinWidth="720" MinHeight="480"
        Background="{StaticResource XnBlackBrush}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <SolidColorBrush x:Key="DotOpen" Color="{StaticResource XnTextFaintColor}" />

    <StreamGeometry x:Key="IconPlus">M 12,5 L 12,19 M 5,12 L 19,12</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M 5,7 L 19,7 M 9,7 L 9,5 L 15,5 L 15,7 M 7,7 L 7,20 L 17,20 L 17,7 M 10,11 L 10,16 M 14,11 L 14,16</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M 6,6 L 18,18 M 18,6 L 6,18</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M 5,13 L 10,18 L 19,7</StreamGeometry>

    <StreamGeometry x:Key="IconDot">M 10,6 L 14,10 L 10,14 L 6,10 Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#5A3030" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#E08080" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A1616" />
    </Style>

    <Style Selector="Button.iconbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource XnTextDimBrush}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>

    <Style Selector="Button.iconbtn.deletebtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A1616" />
    </Style>
    <Style Selector="Button.iconbtn.deletebtn:pointerover PathIcon">
      <Setter Property="Foreground" Value="#E08080" />
    </Style>

    <Style Selector="PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Button.filtertab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource XnTextDimBrush}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.filtertab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>
    <Style Selector="Button.filtertab.active">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource XnTextDimBrush}" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource XnPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource XnAccentBrush}" />
      <Setter Property="SelectionBrush" Value="#33FFFFFF" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#141414" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="300,1,*">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{StaticResource XnBlackBrush}">

      <TextBlock Grid.Row="0" Text="XNOTE"
                 Foreground="{StaticResource XnAccentBrush}"
                 FontSize="15" FontWeight="Medium" LetterSpacing="4"
                 Margin="20,20,20,16" />

      <Grid Grid.Row="1" Margin="16,0,16,12" ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0">
          <TextBox Watermark="Search notes…"
                   Text="{Binding SearchText}"
                   Height="34"
                   Padding="34,0,10,0" />
          <Canvas Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False">
            <Ellipse Width="9" Height="9" Canvas.Left="0" Canvas.Top="0"
                     Stroke="{StaticResource XnTextFaintBrush}" StrokeThickness="1.5" />
            <Line StartPoint="8,8" EndPoint="13,13"
                  Stroke="{StaticResource XnTextFaintBrush}" StrokeThickness="1.5" />
          </Canvas>
        </Grid>
        <Button Grid.Column="1" Classes="iconbtn" Margin="6,0,0,0"
                Command="{Binding AddNoteCommand}"
                ToolTip.Tip="New note (Ctrl+N)">
          <PathIcon Data="{StaticResource IconPlus}" Foreground="{StaticResource XnTextBrush}" />
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,0,16,10">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="filtertab" Classes.active="{Binding IsFilterAll}" Content="All" Command="{Binding SetFilterAllCommand}" />
          <Button Classes="filtertab" Classes.active="{Binding IsFilterNotes}" Content="Notes" Command="{Binding SetFilterNotesCommand}" />
          <Button Classes="filtertab" Classes.active="{Binding IsFilterTasks}" Content="Tasks" Command="{Binding SetFilterTasksCommand}" />
          <Button Classes="filtertab" Classes.active="{Binding IsFilterOpen}" Content="Open" Command="{Binding SetFilterOpenCommand}" />
          <Button Classes="filtertab" Classes.active="{Binding IsFilterDone}" Content="Done" Command="{Binding SetFilterDoneCommand}" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Row="3">
        <ListBox ItemsSource="{Binding FilteredNotes}"
                 SelectedItem="{Binding SelectedNote}"
                 Background="Transparent"
                 Margin="12,0,12,0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NoteViewModel">
              <Grid ColumnDefinitions="Auto,*" Margin="10,8">
                <Grid Grid.Column="0" Width="14" Height="14" Margin="0,3,10,0" VerticalAlignment="Top">
                  <PathIcon Data="{StaticResource IconDot}" Width="10" Height="10"
                            Foreground="{StaticResource XnTextDimBrush}"
                            IsVisible="{Binding !IsTask}" />

                  <Border IsVisible="{Binding IsTask}"
                          Width="14" Height="14" CornerRadius="3"
                          BorderThickness="1.4"
                          BorderBrush="{Binding IsDone, Converter={x:Static vm:Converters.DoneToBrush}}"
                          Background="{Binding IsDone, Converter={x:Static vm:Converters.DoneToBrush}}">
                    <PathIcon Data="{StaticResource IconCheck}"
                              Width="9" Height="9"
                              Foreground="{StaticResource XnBlackBrush}"
                              IsVisible="{Binding IsDone}" />
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Title}"
                             Foreground="{StaticResource XnTextBrush}"
                             FontSize="14" FontWeight="Medium"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Preview}"
                             Foreground="{StaticResource XnTextDimBrush}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="20,10,20,16" Spacing="16">
        <TextBlock Text="{Binding TotalCountLabel}"
                   Foreground="{StaticResource XnTextFaintBrush}" FontSize="11" />
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Background="{StaticResource XnBorderSubtleBrush}" />

    <Grid Grid.Column="2" Background="{StaticResource XnBlackBrush}" IsVisible="{Binding HasSelection}">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32,28,32,24">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   Fill="{StaticResource XnTextFaintBrush}"
                   IsVisible="{Binding SelectedNote.IsDirty}"
                   ToolTip.Tip="Unsaved changes — saves automatically in a moment" />

          <TextBox Grid.Column="1"
                    Text="{Binding SelectedNote.Title, Mode=TwoWay}"
                    FontSize="20" FontWeight="Medium"
                    BorderThickness="0" Background="Transparent"
                    Padding="0" Watermark="Untitled" />

          <ToggleButton Grid.Column="2" Classes="flat" Margin="6,0,0,0"
                        IsChecked="{Binding SelectedNote.IsTask, Mode=TwoWay}"
                        ToolTip.Tip="Mark as a task with a done/not-done state"
                        Content="Task" />
          <ToggleButton Grid.Column="3" Classes="flat" Margin="6,0,0,0"
                        IsChecked="{Binding SelectedNote.IsDone, Mode=TwoWay}"
                        IsVisible="{Binding SelectedNote.IsTask}"
                        ToolTip.Tip="Mark this task as done"
                        Content="Done" />

          <Grid Grid.Column="4" Margin="10,0,0,0">
            <Button Classes="iconbtn deletebtn"
                    Command="{Binding RequestDeleteCommand}"
                    IsVisible="{Binding !IsConfirmingDelete}"
                    ToolTip.Tip="Delete this note">
              <PathIcon Data="{StaticResource IconTrash}" Foreground="{StaticResource XnTextDimBrush}" />
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding IsConfirmingDelete}">
              <TextBlock Text="Delete this note?"
                         Foreground="{StaticResource XnTextDimBrush}"
                         FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
              <Button Classes="danger" Padding="10,6"
                      Command="{Binding ConfirmDeleteCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="#E08080" />
                  <TextBlock Text="Delete" FontSize="12" />
                </StackPanel>
              </Button>
              <Button Classes="flat" Padding="10,6"
                      Command="{Binding CancelDeleteCommand}"
                      Content="Cancel" FontSize="12" />
            </StackPanel>
          </Grid>
        </Grid>

        <TextBox Grid.Row="1" Margin="0,10,0,14"
                 Text="{Binding SelectedNote.TagsText, Mode=TwoWay}"
                 Watermark="Add tags, separated by commas…"
                 FontSize="12" Height="30" />

        <TextBox Grid.Row="2"
                 Text="{Binding SelectedNote.Body, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 BorderThickness="0" Background="Transparent"
                 Padding="0" FontSize="14" LineHeight="22"
                 Watermark="Write something…" />

        <TextBlock Grid.Row="3" Text="{Binding SelectedNote.MetaLabel}"
                   Foreground="{StaticResource XnTextFaintBrush}" FontSize="11"
                   Margin="0,8,0,0" />
      </Grid>
    </Grid>

    <Grid Grid.Column="2" Background="{StaticResource XnBlackBrush}" IsVisible="{Binding !HasSelection}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <PathIcon Data="{StaticResource IconPlus}" Width="28" Height="28"
                   Foreground="{StaticResource XnTextFaintBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="No note selected" Foreground="{StaticResource XnTextDimBrush}"
                   FontSize="14" HorizontalAlignment="Center" />
        <TextBlock Text="Pick a note on the left, or create a new one" Foreground="{StaticResource XnTextFaintBrush}"
                   FontSize="12" HorizontalAlignment="Center" />
        <Button Classes="flat" HorizontalAlignment="Center"
                Command="{Binding AddNoteCommand}" Content="Create your first note" />
      </StackPanel>
    </Grid>

  </Grid>
</Window>