<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XNote.ViewModels"
        x:Class="XNote.Views.TimedNoteSetupWindow"
        x:DataType="vm:TimedNoteSetupViewModel"
        Title="Timed note"
        Width="340" Height="420"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource XnBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource XnTextBrush}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource XnPanelAltBrush}" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Focusable" Value="False" />
    </Style>
  </Window.Styles>

  <Border Background="{StaticResource XnPanelBrush}"
          BorderBrush="{StaticResource XnBorderBrush}"
          BorderThickness="1"
          CornerRadius="10"
          BoxShadow="0 8 28 0 #33000000"
          Margin="10"
          Padding="16">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
        <TextBlock Text="{Binding Ui.SetupTitle}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource XnTextBrush}" />
        <TextBlock Text="{Binding Ui.SetupSubtitle}"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource XnTextDimBrush}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="10">
        <TextBlock Text="{Binding Ui.ExpiryDate}" FontSize="10"
                   Foreground="{StaticResource XnTextFaintBrush}" />
        <CalendarDatePicker SelectedDate="{Binding PendingDate, Mode=TwoWay}"
                            DisplayDate="{Binding MinSelectableDate}"
                            DisplayDateStart="{Binding MinSelectableDate}"
                            DisplayDateEnd="{Binding MaxSelectableDate}"
                            HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding YearRangeText}"
                   FontSize="11"
                   Foreground="{StaticResource XnTextFaintBrush}" />

        <TextBlock Text="{Binding Ui.ExpiryTime}" FontSize="10" Margin="0,4,0,0"
                   Foreground="{StaticResource XnTextFaintBrush}" />
        <TimePicker SelectedTime="{Binding PendingTime, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

        <Border Background="{StaticResource XnPanelAltBrush}"
                BorderBrush="{StaticResource XnBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,6,0,0">
          <TextBlock FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource XnTextDimBrush}"
                     Text="{Binding Ui.SetupConfirmInfo}" />
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Classes="flat" Content="{Binding Ui.Cancel}" Click="Cancel_Click" />
        <Button Content="{Binding Ui.Confirm}"
                Click="Confirm_Click"
                Background="{StaticResource XnTextBrush}"
                Foreground="{StaticResource XnBlackBrush}"
                CornerRadius="6"
                Padding="14,6" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
